# Cache headers for Netlify / Cloudflare Pages (other hosts: set equivalent rules).
# Build assets have content hashes in their filenames, so they never change.
/_nuxt/*
  Cache-Control: public, max-age=31536000, immutable

# Images keep the same URL when replaced, so cache for a week and revalidate in the background.
/_ipx/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/images/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
