# Copy to .env for local builds: cp .env.example .env
# In production set these in your host's build settings instead (Netlify, Cloudflare Pages, ...).
# Values are baked into the static pages at build time and are visible in the page source,
# so never put secrets here.

# Form service URL the contact form POSTs to (Formspree-style: FormData POST, 2xx = success).
# Empty: the form shows an error asking visitors to call.
NUXT_PUBLIC_CONTACT_FORM_ENDPOINT=

# Site domain as added in Plausible, e.g. www.chshydraulics.co.uk.
# Empty: no analytics. (Plausible ignores localhost anyway.)
NUXT_PUBLIC_PLAUSIBLE_DOMAIN=www.crosshandshydraulicservices.co.uk

# Drafts preview deployment only: include unpublished jobs (needs SANITY_READ_TOKEN) and
# noindex every page.
# NUXT_PUBLIC_SHOW_DRAFTS=true

# Admin area (Sanity, /admin): the project and dataset for jobs and reviews. Also read by
# the studio. Empty: the site builds without jobs or reviews.
SANITY_STUDIO_PROJECT_ID=
SANITY_STUDIO_DATASET=production
# Drafts preview deployment only, with NUXT_PUBLIC_SHOW_DRAFTS=true: a Sanity read token
# (Viewer). Secret: set it in the host's build settings, never commit it.
# SANITY_READ_TOKEN=

# Holding page on every URL: coming-soon (before launch) or maintenance (on Vercel, page URLs
# also return 503 with Retry-After). Empty or "live": the normal site.
# NUXT_PUBLIC_SITE_MODE=
